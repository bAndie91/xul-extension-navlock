<?xml version="1.0"?>
<RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:em="http://www.mozilla.org/2004/em-rdf#">
  <Description about="urn:mozilla:install-manifest">
    <em:id>navlock@xulextension.uucp.hu</em:id>
    <em:name>NavLock</em:name>
    <em:version>0.1</em:version>
    <em:description>Lock browser navigation to a domain/path prefix</em:description>
    <em:creator>hband</em:creator>
    <em:homepageURL></em:homepageURL>
    <em:iconURL>chrome://navlock/chrome/content/wheel24.png</em:iconURL>
    <em:type>2</em:type><!-- browser extension -->

    <em:targetApplication>
      <!-- Pale Moon -->
      <Description>
        <em:id>{8de7fcbb-c55c-4fbe-bfc5-fc555c87dbc4}</em:id>
        <em:minVersion>27.0</em:minVersion>
        <em:maxVersion>*</em:maxVersion>
      </Description>
    </em:targetApplication>
    <em:targetApplication>
      <!-- Firefox (classic, up to 56) -->
      <Description>
        <em:id>{ec8030f7-c20a-464f-9b0e-13a3a9e97384}</em:id>
        <em:minVersion>4.0</em:minVersion>
        <em:maxVersion>56.*</em:maxVersion>
      </Description>
    </em:targetApplication>
  </Description>
</RDF>
